{
  "productName": "TuneSmith Local",
  "version": "0.1.0",
  "identifier": "com.tunesmith.local",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "../ui/index.html",
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "TuneSmith Local",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
